{
  "name": "quiz-game",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.30",
    "@angular/common": "20.3.30",
    "@angular/compiler": "20.3.30",
    "@angular/core": "20.3.30",
    "@angular/forms": "20.3.30",
    "@angular/platform-browser": "20.3.30",
    "@angular/router": "20.3.30",
    "@microsoft/signalr": "^8.0.7",
    "@ngrx/signals": "20.1.0",
    "@primeuix/themes": "^1.1.1",
    "primeicons": "^7.0.0",
    "primeng": "20.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.14.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/build": "^20.3.36",
    "@angular/cli": "^20.3.36",
    "@angular/compiler-cli": "20.3.30",
    "@vitest/coverage-v8": "^3.2.7",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.19.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.2.7"
  }
}
